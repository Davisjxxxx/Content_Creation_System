{
  "1": {"class_type": "UnetLoaderGGUF", "inputs": {"unet_name": "${WAN_HIGH_MODEL}"}, "_meta": {"title": "Wan 2.2 I2V 14B high-noise expert (GGUF)"}},
  "2": {"class_type": "UnetLoaderGGUF", "inputs": {"unet_name": "${WAN_LOW_MODEL}"}, "_meta": {"title": "Wan 2.2 I2V 14B low-noise expert (GGUF)"}},
  "3": {"class_type": "LoraLoaderModelOnly", "inputs": {"model": ["1", 0], "lora_name": "${WAN_HIGH_LORA}", "strength_model": 1.0}, "_meta": {"title": "Lightning 4-step LoRA (high)"}},
  "4": {"class_type": "LoraLoaderModelOnly", "inputs": {"model": ["2", 0], "lora_name": "${WAN_LOW_LORA}", "strength_model": 1.0}, "_meta": {"title": "Lightning 4-step LoRA (low)"}},
  "5": {"class_type": "ModelSamplingSD3", "inputs": {"model": ["3", 0], "shift": 5.0}},
  "6": {"class_type": "ModelSamplingSD3", "inputs": {"model": ["4", 0], "shift": 5.0}},
  "7": {"class_type": "CLIPLoader", "inputs": {"clip_name": "${WAN_TEXT_ENCODER}", "type": "wan", "device": "default"}},
  "8": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["7", 0], "text": "${PROMPT}"}, "_meta": {"title": "Positive prompt"}},
  "9": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["7", 0], "text": "${WAN_NEGATIVE}"}, "_meta": {"title": "Negative prompt (no effect at CFG 1)"}},
  "10": {"class_type": "VAELoader", "inputs": {"vae_name": "${WAN_VAE}"}},
  "11": {"class_type": "LoadImage", "inputs": {"image": "${INIT_IMAGE}"}, "_meta": {"title": "Start photo"}},
  "12": {"class_type": "WanImageToVideo", "inputs": {"positive": ["8", 0], "negative": ["9", 0], "vae": ["10", 0], "start_image": ["11", 0], "width": "${WAN_WIDTH}", "height": "${WAN_HEIGHT}", "length": "${WAN_LENGTH}", "batch_size": 1}},
  "13": {"class_type": "KSamplerAdvanced", "inputs": {"model": ["5", 0], "add_noise": "enable", "noise_seed": "${WAN_SEED}", "steps": 4, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "positive": ["12", 0], "negative": ["12", 1], "latent_image": ["12", 2], "start_at_step": 0, "end_at_step": 2, "return_with_leftover_noise": "enable"}, "_meta": {"title": "Steps 1-2 (high-noise expert)"}},
  "14": {"class_type": "KSamplerAdvanced", "inputs": {"model": ["6", 0], "add_noise": "disable", "noise_seed": "${WAN_SEED}", "steps": 4, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "positive": ["12", 0], "negative": ["12", 1], "latent_image": ["13", 0], "start_at_step": 2, "end_at_step": 4, "return_with_leftover_noise": "disable"}, "_meta": {"title": "Steps 3-4 (low-noise expert)"}},
  "15": {"class_type": "VAEDecode", "inputs": {"samples": ["14", 0], "vae": ["10", 0]}},
  "16": {"class_type": "CreateVideo", "inputs": {"images": ["15", 0], "fps": 16}},
  "17": {"class_type": "SaveVideo", "inputs": {"video": ["16", 0], "filename_prefix": "${WAN_PREFIX}", "format": "mp4", "codec": "h264"}}
}
